---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAllPosts } from '../../../lib/blog';
import { BLOG_CATEGORIES } from '../../../lib/constants';
import { actions } from 'astro:actions';
import { Icon } from 'astro-icon/components';

const result = Astro.getActionResult(actions.deletePost);
if (result && !result.error) {
	return Astro.redirect('/admin/blog');
}
const posts = await getAllPosts();

const categoryLabel = (value: string) => BLOG_CATEGORIES.find((c) => c.value === value)?.label ?? value;
---

<AdminLayout title="Blog">
	<div class="crumb">KONCRETA ADMIN // BLOG</div>
	<div class="admin-head">
		<div>
			<h1>Blog</h1>
		</div>
		<a href="/admin/blog/nuevo" class="btn btn-primary">+ Nuevo post</a>
	</div>
	{result?.error && <p class="action-error">{result.error.message}</p>}

	<div class="controls-bar">
		<div class="search-field">
			<Icon name="material-symbols:search" class="icon" />
			<input type="text" id="filter-search" placeholder="Buscar por título..." />
		</div>
		<div class="controls-filters">
			<select id="filter-category">
				<option value="">Todas las categorías</option>
				{BLOG_CATEGORIES.map((cat) => <option value={cat.value}>{cat.label}</option>)}
			</select>
			<select id="filter-status">
				<option value="">Todos los estados</option>
				<option value="true">Publicado</option>
				<option value="false">Borrador</option>
			</select>
		</div>
	</div>

	<div class="admin-card table-card">
		<table class="admin-table">
			<colgroup>
				<col style="width: auto;" />
				<col style="width: 190px;" />
				<col style="width: 140px;" />
				<col style="width: 110px;" />
				<col style="width: 90px;" />
			</colgroup>
			<thead>
				<tr>
					<th>Título</th>
					<th>Categoría</th>
					<th>Publicado</th>
					<th>Destacado</th>
					<th></th>
				</tr>
			</thead>
			<tbody id="posts-tbody">
				{
					posts.map((p) => (
						<tr data-category={p.category} data-published={String(p.published)} data-title={p.title.toLowerCase()}>
							<td>
								<div class="row-title">
									<div class="row-thumb">
										{p.hero_image_url ? (
											<img src={p.hero_image_url} alt={p.hero_image_alt ?? p.title} />
										) : (
											<Icon name="material-symbols:article" class="icon" />
										)}
									</div>
									<div>
										<div class="t">
											{p.title}
											{p.featured && <span title="Destacado"> ★</span>}
										</div>
										<span class="sub">{categoryLabel(p.category)}</span>
									</div>
								</div>
							</td>
							<td><span class="category-pill">{categoryLabel(p.category)}</span></td>
							<td>
								<span class={`status-pill ${p.published ? 'on' : 'off'}`}>
									<span class="dot" />
									{p.published ? 'Publicado' : 'Borrador'}
								</span>
							</td>
							<td>{p.featured ? '★' : ''}</td>
							<td>
								<div class="row-actions">
									<a href={`/admin/blog/${p.id}`} title="Editar">
										<Icon name="material-symbols:edit" class="icon" />
									</a>
									<form method="POST" action={actions.deletePost}>
										<input type="hidden" name="id" value={p.id} />
										<button type="submit" data-confirm="¿Eliminar este post?" title="Eliminar">
											<Icon name="material-symbols:delete" class="icon" />
										</button>
									</form>
								</div>
							</td>
						</tr>
					))
				}
				<tr id="posts-empty-filter" style="display:none;">
					<td colspan="5" class="empty-cell">
						No se encontraron posts con los filtros seleccionados.
					</td>
				</tr>
				{
					posts.length === 0 && (
						<tr>
							<td colspan="5" class="empty-cell">
								Todavía no hay posts. <a href="/admin/blog/nuevo">Escribe el primero →</a>
							</td>
						</tr>
					)
				}
			</tbody>
		</table>
		<div class="table-foot" id="posts-counter">Mostrando {posts.length} posts</div>
	</div>
</AdminLayout>

<script is:inline>
	document.querySelectorAll('button[data-confirm]').forEach((btn) => {
		btn.addEventListener('click', (e) => {
			if (!confirm(btn.dataset.confirm)) e.preventDefault();
		});
	});

	const searchInput = document.getElementById('filter-search');
	const categorySelect = document.getElementById('filter-category');
	const statusSelect = document.getElementById('filter-status');
	const rows = Array.from(document.querySelectorAll('#posts-tbody tr[data-title]'));
	const emptyFilterRow = document.getElementById('posts-empty-filter');
	const counterEl = document.getElementById('posts-counter');
	const totalPosts = rows.length;

	function applyFilters() {
		const search = (searchInput?.value || '').trim().toLowerCase();
		const category = categorySelect?.value || '';
		const status = statusSelect?.value || '';
		let visibleCount = 0;

		rows.forEach((row) => {
			const matchesSearch = !search || row.dataset.title.includes(search);
			const matchesCategory = !category || row.dataset.category === category;
			const matchesStatus = !status || row.dataset.published === status;
			const isVisible = matchesSearch && matchesCategory && matchesStatus;
			row.style.display = isVisible ? '' : 'none';
			if (isVisible) visibleCount++;
		});

		if (emptyFilterRow) {
			emptyFilterRow.style.display = (visibleCount === 0 && totalPosts > 0) ? '' : 'none';
		}
		if (counterEl) {
			counterEl.textContent = (visibleCount === totalPosts)
				? `Mostrando ${totalPosts} posts`
				: `Mostrando ${visibleCount} de ${totalPosts} posts`;
		}
	}

	searchInput?.addEventListener('input', applyFilters);
	categorySelect?.addEventListener('change', applyFilters);
	statusSelect?.addEventListener('change', applyFilters);
</script>
