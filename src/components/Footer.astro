---
// Styles live in src/styles/global.css (footer rules copied verbatim from the template).
const today = new Date();
---

<footer>
	<div class="container">
		<div class="footer-grid">
			<div>
				<div class="logo" style="margin-bottom:16px;color:#fff;">
					<span class="mark" style="color:#fff;">
						<svg viewBox="0 0 100 100" width="26" height="26"
							><circle cx="50" cy="50" r="50" fill="currentColor"></circle><path
								d="M27 30 L50 68 L73 30 L60 30 L50 47 L40 30 Z"
								fill="#000"></path></svg
						>
					</span>
					<span>KONCRETA<span class="pref">Prefabricados</span></span>
				</div>
				<p style="max-width:300px;font-size:0.84rem;line-height:1.7;">
					Fabricamos soluciones de hormigón 100% a la medida. Plantas en Antofagasta y Pozo
					Almonte.
				</p>
			</div>
			<div>
				<h5>Navegación</h5>
				<ul>
					<li><a href="/">Inicio</a></li>
					<li><a href="/servicios">Servicios</a></li>
					<li><a href="/proyectos">Proyectos</a></li>
					<li><a href="/blog">Blog</a></li>
					<li><a href="/contacto">Contacto</a></li>
				</ul>
			</div>
			<div>
				<h5>Plantas</h5>
				<ul>
					<li>Antofagasta</li>
					<li>Pozo Almonte</li>
				</ul>
			</div>
			<div>
				<h5>Contacto</h5>
				<ul>
					<li><a href="tel:+56900000000">+56 9 0000 0000</a></li>
					<li><a href="https://wa.me/56900000000">WhatsApp directo</a></li>
				</ul>
			</div>
		</div>
		<div class="footer-bottom">
			<span>&copy; {today.getFullYear()} Koncreta Prefabricados</span>
			<span>visu.cl</span>
		</div>
	</div>
</footer>
