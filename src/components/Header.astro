---
// Styles live in src/styles/global.css (header rules copied verbatim from the template).
const nav = [
	{ href: '/', label: 'Inicio' },
	{ href: '/servicios', label: 'Servicios' },
	{ href: '/proyectos', label: 'Proyectos' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/contacto', label: 'Contacto' },
];
---

<header>
	<div class="header-inner">
		<a href="/" class="logo">
			<span class="mark">
				<svg viewBox="0 0 100 100" width="26" height="26"
					><circle cx="50" cy="50" r="50" fill="currentColor"></circle><path
						d="M27 30 L50 68 L73 30 L60 30 L50 47 L40 30 Z"
						fill="var(--paper)"></path></svg
				>
			</span>
			<span>KONCRETA<span class="pref">Prefabricados</span></span>
		</a>
		<nav class="desktop-nav">
			<ul>
				{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
			</ul>
		</nav>
		<a href="/contacto" class="header-cta">Cotiza tu proyecto</a>
		<button
			class="burger"
			onclick="document.querySelector('.mobile-menu').classList.toggle('open')"
			aria-label="Abrir menú">☰</button
		>
	</div>
	<div class="mobile-menu">
		{nav.map((item) => <a href={item.href}>{item.label}</a>)}
		<a href="/contacto" class="header-cta">Cotiza tu proyecto</a>
	</div>
</header>
