---
import '../styles/global.css';
import '../styles/admin.css';
import { actions } from 'astro:actions';
import { Icon } from 'astro-icon/components';

interface Props {
	title: string;
}
const { title } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const showChrome = user && path !== '/admin/login';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} — Panel Koncreta</title>
		<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body class="admin-body">
		{
			showChrome && (
				<div class="admin-bar">
					<div class="admin-bar-inner">
						<div class="admin-brand">
							<span class="name">Koncreta</span>
						</div>
						<nav class="admin-nav">
							<a href="/admin" class={path === '/admin' ? 'active' : ''}>Inicio</a>
							<a href="/admin/proyectos" class={path.startsWith('/admin/proyectos') ? 'active' : ''}>Proyectos</a>
							<a href="/admin/blog" class={path.startsWith('/admin/blog') ? 'active' : ''}>Blog</a>
						</nav>
						<div class="admin-topbar-actions">
							<div class="search-field">
								<Icon name="material-symbols:search" class="icon" />
								<input type="text" id="header-search" placeholder="Buscar..." />
							</div>
							<button type="button" class="admin-icon-btn" title="Notificaciones" aria-label="Notificaciones">
								<Icon name="material-symbols:notifications" class="icon" />
							</button>
							<button type="button" class="admin-icon-btn" title="Configuración" aria-label="Configuración">
								<Icon name="material-symbols:settings" class="icon" />
							</button>
							<a href="/" target="_blank" class="admin-view-site">Ver sitio ↗</a>
							<div class="admin-user">
								<div class="who">
									<span class="avatar">{user.email[0]?.toUpperCase()}</span>
								</div>
								<form method="POST" action={actions.logout}>
									<button type="submit">Salir</button>
								</form>
							</div>
						</div>
					</div>
				</div>
			)
		}
		<main class="admin-main">
			<slot />
		</main>
		{
			showChrome && (
				<footer class="admin-footer">
					<div class="admin-footer-inner">
						<span>© {new Date().getFullYear()} Koncreta Prefabricados — Panel interno</span>
						<div class="admin-footer-links">
							<a href="/" target="_blank">Ver sitio</a>
							<a href="mailto:viveka.guarino@koncretaprefabricados.cl">Soporte</a>
						</div>
					</div>
				</footer>
			)
		}
		{
			showChrome && (
				<script is:inline>
					const headerSearch = document.getElementById('header-search');
					const pageSearch = document.getElementById('filter-search');
					if (headerSearch && pageSearch) {
						headerSearch.addEventListener('input', () => {
							pageSearch.value = headerSearch.value;
							pageSearch.dispatchEvent(new Event('input'));
						});
					}
				</script>
			)
		}
	</body>
</html>
