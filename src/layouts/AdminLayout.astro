---
import '../styles/global.css';
import '../styles/admin.css';
import { actions } from 'astro:actions';
import { Icon } from 'astro-icon/components';

interface Props {
	title: string;
}
const { title } = Astro.props;

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult && !logoutResult.error) {
	return Astro.redirect('/admin/login');
}

const user = Astro.locals.user;
const path = Astro.url.pathname;
const showChrome = user && path !== '/admin/login';

---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} — Panel Koncreta</title>
		<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body class="admin-body">
		{
			showChrome && (
				<div class="admin-bar">
					<div class="admin-bar-inner">
						<div class="admin-brand">
							<span class="name">Koncreta</span>
						</div>
						<nav class="admin-nav">
							<a href="/admin" class={path === '/admin' ? 'active' : ''}>Inicio</a>
							<a href="/admin/proyectos" class={path.startsWith('/admin/proyectos') ? 'active' : ''}>Proyectos</a>
							<a href="/admin/blog" class={path.startsWith('/admin/blog') ? 'active' : ''}>Blog</a>
						</nav>
						<div class="admin-topbar-actions">
							<div class="admin-user">
								<button type="button" class="avatar-btn" id="user-menu-btn" aria-haspopup="true" aria-expanded="false">
									<span class="avatar">{user.email[0]?.toUpperCase()}</span>
								</button>
								<div class="user-dropdown" id="user-dropdown" hidden>
									<div class="user-dropdown-email">{user.email}</div>
									<a href="/" target="_blank" class="user-dropdown-item">
										<Icon name="material-symbols:open-in-new" class="icon" />
										Ver sitio
									</a>
									<button type="button" class="user-dropdown-item">
										<Icon name="material-symbols:settings" class="icon" />
										Configuración
									</button>
									<form method="POST" action={actions.logout}>
										<button type="submit" class="user-dropdown-item">
											<Icon name="material-symbols:logout" class="icon" />
											Salir
										</button>
									</form>
								</div>
							</div>
						</div>
					</div>
				</div>
			)
		}
		<main class="admin-main">
			<slot />
		</main>
		{
			showChrome && (
				<footer class="admin-footer">
					<div class="admin-footer-inner">
						<span>© {new Date().getFullYear()} Koncreta Prefabricados — Panel interno</span>
						<div class="admin-footer-links">
							<a href="/" target="_blank">Ver sitio</a>
							<a href="mailto:viveka.guarino@koncretaprefabricados.cl">Soporte</a>
						</div>
					</div>
				</footer>
			)
		}
		{
			showChrome && (
				<script is:inline>
					const menuBtn = document.getElementById('user-menu-btn');
					const dropdown = document.getElementById('user-dropdown');
					if (menuBtn && dropdown) {
						menuBtn.addEventListener('click', (e) => {
							e.stopPropagation();
							const isOpen = !dropdown.hidden;
							dropdown.hidden = isOpen;
							menuBtn.setAttribute('aria-expanded', String(!isOpen));
						});
						document.addEventListener('click', (e) => {
							if (!dropdown.hidden && !dropdown.contains(e.target)) {
								dropdown.hidden = true;
								menuBtn.setAttribute('aria-expanded', 'false');
							}
						});
						document.addEventListener('keydown', (e) => {
							if (e.key === 'Escape' && !dropdown.hidden) {
								dropdown.hidden = true;
								menuBtn.setAttribute('aria-expanded', 'false');
							}
						});
					}

					// Controlador de Uploader de Imágenes con 4 Estados:
					// 1. Vacío (empty)
					// 2. Arrastrando archivo (is-dragging)
					// 3. Con imagen actual guardada (has-current)
					// 4. Con nueva imagen seleccionada lista para guardar (preview-ready)
					document.querySelectorAll('[data-image-uploader]').forEach((uploader) => {
						const dropzone = uploader.querySelector('.dropzone');
						const input = dropzone?.querySelector('input[type="file"]');
						let previewWrap = uploader.querySelector('.dz-preview-wrap');
						const form = uploader.closest('form');
						const existingInput = form?.querySelector('input[name="existing_image_url"]');
						const originalExistingUrl = existingInput ? existingInput.value : '';

						if (!dropzone || !input) return;

						function showError(msg) {
							let errEl = uploader.querySelector('.dz-error-msg');
							if (!errEl) {
								errEl = document.createElement('div');
								errEl.className = 'dz-error-msg action-error';
								errEl.style.marginTop = '10px';
								errEl.style.marginBottom = '10px';
								uploader.appendChild(errEl);
							}
							errEl.textContent = msg;
						}

						function clearError() {
							const errEl = uploader.querySelector('.dz-error-msg');
							if (errEl) errEl.remove();
						}

						function renderNewPreview(file) {
							clearError();
							const sizeMb = (file.size / (1024 * 1024)).toFixed(1);
							
							if (!previewWrap) {
								previewWrap = document.createElement('div');
								previewWrap.className = 'dz-preview-wrap';
								uploader.prepend(previewWrap);
							}

							previewWrap.innerHTML = `
								<span class="dz-badge badge-new"><span class="badge-dot"></span> Nueva imagen seleccionada</span>
								<img src="" alt="Previsualización" />
								<div class="dz-actions-bar">
									<span class="dz-file-info">${file.name} (${sizeMb} MB)</span>
									<button type="button" class="dz-btn-action btn-revert" data-action="revert">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
										<span>Deshacer</span>
									</button>
								</div>
							`;

							const img = previewWrap.querySelector('img');
							const reader = new FileReader();
							reader.onload = (e) => {
								if (e.target?.result && img) img.src = e.target.result;
							};
							reader.readAsDataURL(file);

							dropzone.style.display = 'none';
							bindPreviewActions();
						}

						function restoreOriginal() {
							clearError();
							input.value = '';
							if (originalExistingUrl) {
								if (existingInput) existingInput.value = originalExistingUrl;
								if (!previewWrap) {
									previewWrap = document.createElement('div');
									previewWrap.className = 'dz-preview-wrap';
									uploader.prepend(previewWrap);
								}
								previewWrap.innerHTML = `
									<span class="dz-badge badge-current"><span class="badge-dot"></span> Imagen actual</span>
									<img src="${originalExistingUrl}" alt="" />
									<div class="dz-actions-bar">
										<button type="button" class="dz-btn-action btn-change" data-action="change">
											<svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/></svg>
											<span>Cambiar imagen</span>
										</button>
										<button type="button" class="dz-btn-action btn-danger" data-action="remove">
											<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
											<span>Quitar imagen</span>
										</button>
									</div>
								`;
								dropzone.style.display = 'none';
								bindPreviewActions();
							} else {
								if (previewWrap) {
									previewWrap.remove();
									previewWrap = null;
								}
								dropzone.style.display = 'flex';
							}
						}

						function removeImageCompletely() {
							clearError();
							input.value = '';
							if (existingInput) existingInput.value = '';
							if (previewWrap) {
								previewWrap.remove();
								previewWrap = null;
							}
							dropzone.style.display = 'flex';
						}

						function bindPreviewActions() {
							if (!previewWrap) return;
							const changeBtn = previewWrap.querySelector('[data-action="change"]');
							const removeBtn = previewWrap.querySelector('[data-action="remove"]');
							const revertBtn = previewWrap.querySelector('[data-action="revert"]');

							changeBtn?.addEventListener('click', () => {
								input.click();
							});

							removeBtn?.addEventListener('click', () => {
								if (confirm('¿Quitar la imagen de este registro?')) {
									removeImageCompletely();
								}
							});

							revertBtn?.addEventListener('click', () => {
								restoreOriginal();
							});
						}

						function validateAndProcess(file) {
							if (!file) return;
							if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
								showError('Formato no permitido. Por favor selecciona una imagen JPG, PNG o WebP.');
								input.value = '';
								return;
							}
							if (file.size > 5 * 1024 * 1024) {
								const sizeMb = (file.size / (1024 * 1024)).toFixed(1);
								showError(`La imagen seleccionada pesa ${sizeMb}MB y supera el máximo de 5MB permitidos.`);
								input.value = '';
								return;
							}
							renderNewPreview(file);
						}

						input.addEventListener('change', () => {
							const file = input.files?.[0];
							if (file) validateAndProcess(file);
						});

						// Soporte activo de Drag & Drop en cualquier estado (vacío o sobre la foto actual)
						['dragenter', 'dragover'].forEach((eventName) => {
							uploader.addEventListener(eventName, (e) => {
								e.preventDefault();
								e.stopPropagation();
								dropzone.classList.add('is-dragging');
								if (previewWrap) previewWrap.classList.add('is-dragging');
							});
						});

						['dragleave', 'drop'].forEach((eventName) => {
							uploader.addEventListener(eventName, (e) => {
								e.preventDefault();
								e.stopPropagation();
								dropzone.classList.remove('is-dragging');
								if (previewWrap) previewWrap.classList.remove('is-dragging');
							});
						});

						uploader.addEventListener('drop', (e) => {
							e.preventDefault();
							e.stopPropagation();
							dropzone.classList.remove('is-dragging');
							if (previewWrap) previewWrap.classList.remove('is-dragging');
							const dt = e.dataTransfer;
							const file = dt?.files?.[0];
							if (file) {
								input.files = dt.files;
								validateAndProcess(file);
							}
						});

						bindPreviewActions();
					});
				</script>
			)
		}
	</body>
</html>
