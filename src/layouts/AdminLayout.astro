---
import '../styles/global.css';
import '../styles/admin.css';
import { actions } from 'astro:actions';
import { Icon } from 'astro-icon/components';

interface Props {
	title: string;
}
const { title } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const showChrome = user && path !== '/admin/login';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} — Panel Koncreta</title>
		<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body class="admin-body">
		{
			showChrome && (
				<div class="admin-bar">
					<div class="admin-bar-inner">
						<div class="admin-brand">
							<span class="name">Koncreta</span>
						</div>
						<nav class="admin-nav">
							<a href="/admin" class={path === '/admin' ? 'active' : ''}>Inicio</a>
							<a href="/admin/proyectos" class={path.startsWith('/admin/proyectos') ? 'active' : ''}>Proyectos</a>
							<a href="/admin/blog" class={path.startsWith('/admin/blog') ? 'active' : ''}>Blog</a>
						</nav>
						<div class="admin-topbar-actions">
							<div class="admin-user">
								<button type="button" class="avatar-btn" id="user-menu-btn" aria-haspopup="true" aria-expanded="false">
									<span class="avatar">{user.email[0]?.toUpperCase()}</span>
								</button>
								<div class="user-dropdown" id="user-dropdown" hidden>
									<div class="user-dropdown-email">{user.email}</div>
									<a href="/" target="_blank" class="user-dropdown-item">
										<Icon name="material-symbols:open-in-new" class="icon" />
										Ver sitio
									</a>
									<button type="button" class="user-dropdown-item">
										<Icon name="material-symbols:settings" class="icon" />
										Configuración
									</button>
									<form method="POST" action={actions.logout}>
										<button type="submit" class="user-dropdown-item">
											<Icon name="material-symbols:logout" class="icon" />
											Salir
										</button>
									</form>
								</div>
							</div>
						</div>
					</div>
				</div>
			)
		}
		<main class="admin-main">
			<slot />
		</main>
		{
			showChrome && (
				<footer class="admin-footer">
					<div class="admin-footer-inner">
						<span>© {new Date().getFullYear()} Koncreta Prefabricados — Panel interno</span>
						<div class="admin-footer-links">
							<a href="/" target="_blank">Ver sitio</a>
							<a href="mailto:viveka.guarino@koncretaprefabricados.cl">Soporte</a>
						</div>
					</div>
				</footer>
			)
		}
		{
			showChrome && (
				<script is:inline>
					const menuBtn = document.getElementById('user-menu-btn');
					const dropdown = document.getElementById('user-dropdown');
					if (menuBtn && dropdown) {
						menuBtn.addEventListener('click', (e) => {
							e.stopPropagation();
							const isOpen = !dropdown.hidden;
							dropdown.hidden = isOpen;
							menuBtn.setAttribute('aria-expanded', String(!isOpen));
						});
						document.addEventListener('click', (e) => {
							if (!dropdown.hidden && !dropdown.contains(e.target)) {
								dropdown.hidden = true;
								menuBtn.setAttribute('aria-expanded', 'false');
							}
						});
						document.addEventListener('keydown', (e) => {
							if (e.key === 'Escape' && !dropdown.hidden) {
								dropdown.hidden = true;
								menuBtn.setAttribute('aria-expanded', 'false');
							}
						});
					}

					// Previsualización y validación inmediata al elegir o arrastrar una imagen en la dropzone
					document.querySelectorAll('.dropzone input[type="file"]').forEach((input) => {
						const dropzone = input.closest('.dropzone');
						if (!dropzone) return;

						function showError(msg) {
							let errEl = dropzone.parentElement?.querySelector('.dz-error-msg');
							if (!errEl) {
								errEl = document.createElement('div');
								errEl.className = 'dz-error-msg action-error';
								errEl.style.marginTop = '10px';
								errEl.style.marginBottom = '10px';
								dropzone.parentElement?.appendChild(errEl);
							}
							errEl.textContent = msg;
						}

						function clearError() {
							const errEl = dropzone.parentElement?.querySelector('.dz-error-msg');
							if (errEl) errEl.remove();
						}

						function updatePreview(file) {
							if (!file) return;
							clearError();
							if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
								showError('Formato no permitido. Por favor selecciona una imagen JPG, PNG o WebP.');
								input.value = '';
								return;
							}
							if (file.size > 5 * 1024 * 1024) {
								const sizeMb = (file.size / (1024 * 1024)).toFixed(1);
								showError(`La imagen pesa ${sizeMb}MB y supera el límite de 5MB permitidos. Por favor sube una imagen de menor peso.`);
								input.value = '';
								return;
							}
							let img = dropzone.querySelector('img');
							if (!img) {
								img = document.createElement('img');
								img.alt = '';
								dropzone.prepend(img);
							}
							const reader = new FileReader();
							reader.onload = (e) => {
								if (e.target?.result) img.src = e.target.result;
							};
							reader.readAsDataURL(file);
						}

						input.addEventListener('change', () => {
							const file = input.files?.[0];
							if (file) updatePreview(file);
						});

						['dragenter', 'dragover'].forEach((eventName) => {
							dropzone.addEventListener(eventName, (e) => {
								e.preventDefault();
								e.stopPropagation();
								dropzone.style.borderColor = 'var(--naranja)';
							});
						});

						['dragleave', 'drop'].forEach((eventName) => {
							dropzone.addEventListener(eventName, (e) => {
								e.preventDefault();
								e.stopPropagation();
								dropzone.style.borderColor = '';
							});
						});

						dropzone.addEventListener('drop', (e) => {
							const dt = e.dataTransfer;
							const file = dt?.files?.[0];
							if (file) {
								input.files = dt.files;
								updatePreview(file);
							}
						});
					});
				</script>
			)
		}
	</body>
</html>
