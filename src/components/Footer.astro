---
// Styles live in src/styles/global.css (footer rules copied verbatim from the template).

const today = new Date();
---

<footer>
	<div class="container">
		<div class="footer-grid">
			<div>
				<div class="logo" style="margin-bottom:16px;">
					<img src="/logo-lockup-light.png" alt="Koncreta Prefabricados" width="379" height="146" />
				</div>
				<p style="max-width:300px;font-size:0.84rem;line-height:1.7;">
					Fabricamos soluciones de hormigón 100% a la medida. Plantas en Antofagasta y Pozo
					Almonte.
				</p>
			</div>
			<div>
				<h5>Navegación</h5>
				<ul>
					<li><a href="/">Inicio</a></li>
					<li><a href="/servicios">Servicios</a></li>
					<li><a href="/proyectos">Proyectos</a></li>
					<li><a href="/blog">Blog</a></li>
					<li><a href="/contacto">Contacto</a></li>
				</ul>
			</div>
			<div>
				<h5>Plantas</h5>
				<ul>
					<li>Antofagasta</li>
					<li>Pozo Almonte</li>
				</ul>
			</div>
			<div>
				<h5>Contacto</h5>
				<ul>
					<li><a href="tel:+56983984326">+56 9 8398 4326</a></li>
					<li><a href="https://wa.me/56983984326">WhatsApp directo</a></li>
				</ul>
				<!-- ponytail: iconos Lucide inline; currentColor hereda el gris y el hover naranja de los links -->
				<div class="footer-social">
					<a href="https://www.instagram.com/koncretaprefabricados.cl/" target="_blank" rel="noopener" aria-label="Instagram">
						<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5"/></svg>
					</a>
					<a href="https://www.linkedin.com/company/koncreta-prefabricados/posts/" target="_blank" rel="noopener" aria-label="LinkedIn">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
					</a>
					<a href="https://www.facebook.com/profile.php?id=61572424299215" target="_blank" rel="noopener" aria-label="Facebook">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
					</a>
				</div>
			</div>
		</div>
		<div class="footer-bottom">
			<span>&copy; {today.getFullYear()} Koncreta Prefabricados</span>
			<span>Diseñado y desarrollado por <a href="https://www.kam-mkt.com">www.kam-mkt.com</a></span>
		</div>
	</div>
</footer>
