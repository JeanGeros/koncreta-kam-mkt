---
import '../styles/global.css';
import '../styles/servicios.css';
import Base from '../layouts/Base.astro';
---

<Base title="Nuestros Servicios — Koncreta Prefabricados">
<!-- ===================== SERVICIOS HERO ===================== -->
<section class="servicios-hero" id="inicio">
  <div class="container">
    <div class="servicios-hero-row">
      <div>
        <div class="idx">Lo que hacemos</div>
        <h1>Nuestros Servicios</h1>
        <p>Seis frentes de trabajo bajo un mismo techo: de la asesoría de ingeniería al montaje final en obra, sin subcontratar ni intermediarios.</p>
      </div>
      <a class="btn btn-primary" href="https://wa.me/56983984326?text=Hola%20Koncreta%2C%20quiero%20cotizar%20un%20servicio" target="_blank" rel="noopener">Cotiza aquí</a>
    </div>
  </div>
</section>

<!-- ===================== SERVICE EXPLORER (interactivo) ===================== -->
<section class="explorer">
  <div class="container">
    <div class="explorer-wrap" data-reveal>

      <div class="explorer-tabs" id="explorer-tabs">
        <button class="explorer-tab active" data-service="0"><span class="et-num mono">01</span><span class="et-title">Asesoría de cambio in situ a prefabricado</span><span class="et-arrow"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></button>
        <button class="explorer-tab" data-service="1"><span class="et-num mono">02</span><span class="et-title">Fabricación de piezas de hormigón</span><span class="et-arrow"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></button>
        <button class="explorer-tab" data-service="2"><span class="et-num mono">03</span><span class="et-title">Ingeniería de modulación e izajes</span><span class="et-arrow"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></button>
        <button class="explorer-tab" data-service="3"><span class="et-num mono">04</span><span class="et-title">Transporte de piezas de hormigón</span><span class="et-arrow"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></button>
        <button class="explorer-tab" data-service="4"><span class="et-num mono">05</span><span class="et-title">Montaje de piezas en obra</span><span class="et-arrow"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></button>
        <button class="explorer-tab" data-service="5"><span class="et-num mono">06</span><span class="et-title">Piezas ornamentales y áreas verdes</span><span class="et-arrow"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></button>
      </div>

      <div class="explorer-panel" id="explorer-panel">
        <!-- contenido inyectado por JS -->
      </div>

    </div>
  </div>
</section>

<!-- ===================== QUÉ NOS HACE DIFERENTES ===================== -->
<section class="diff-full" id="diferencias">
  <div class="container">
    <div class="idx" data-reveal>Ventaja competitiva</div>
    <div class="section-head" data-reveal><h3>¿Qué nos hace diferentes?</h3></div>

    <div class="diff-full-list" data-reveal>
      <div class="diff-full-item open">
        <button class="diff-full-trigger" type="button">
          <span class="diff-full-num">01</span>
          <h4>Capacidad Exclusiva — 2 Plantas Operativas</h4>
          <span class="diff-full-plus"><span></span><span></span></span>
        </button>
        <div class="diff-full-panel">
          <div class="diff-full-panel-inner">
            <p>Contamos con infraestructura propia en Antofagasta y Pozo Almonte. Para garantizar el cumplimiento absoluto de plazos y atención personalizada, no tomamos más de 2 proyectos en paralelo por planta.</p>
          </div>
        </div>
      </div>

      <div class="diff-full-item">
        <button class="diff-full-trigger" type="button">
          <span class="diff-full-num">02</span>
          <h4>Trato Directo con la Oficina Técnica</h4>
          <span class="diff-full-plus"><span></span><span></span></span>
        </button>
        <div class="diff-full-panel">
          <div class="diff-full-panel-inner">
            <p>Brindamos una atención cercana respaldada por nuestro equipo profesional. No hablas con intermediarios: te reúnes directamente con nuestro calculista o proyectista para resolver problemas y ajustar la ingeniería en tiempo real.</p>
          </div>
        </div>
      </div>

      <div class="diff-full-item">
        <button class="diff-full-trigger" type="button">
          <span class="diff-full-num">03</span>
          <h4>Trazabilidad Certificada — Norma Chilena</h4>
          <span class="diff-full-plus"><span></span><span></span></span>
        </button>
        <div class="diff-full-panel">
          <div class="diff-full-panel-inner">
            <p>Control de calidad riguroso con trazabilidad garantizada pieza a pieza, cumpliendo con los altos estándares exigidos por la industria minera y energética.</p>
          </div>
        </div>
      </div>

      <div class="diff-full-item">
        <button class="diff-full-trigger" type="button">
          <span class="diff-full-num">04</span>
          <h4>Logística Minera — Vehículos Homologados</h4>
          <span class="diff-full-plus"><span></span><span></span></span>
        </button>
        <div class="diff-full-panel">
          <div class="diff-full-panel-inner">
            <p>Despachamos con transporte propio homologado para ingresar directamente a faenas de alta exigencia, asegurando un montaje continuo y sin contratiempos.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===================== CTA BAND ===================== -->
<section class="servicios-cta-band">
  <div class="container">
    <div class="servicios-cta-inner" data-reveal>
      <h3>¿No sabes cuál de estos servicios necesitas?</h3>
      <a class="btn btn-primary" href="https://wa.me/56983984326?text=Hola%20Koncreta%2C%20no%20s%C3%A9%20qu%C3%A9%20servicio%20necesito%2C%20%C2%BFme%20pueden%20orientar%3F" target="_blank" rel="noopener">Que un ingeniero de Koncreta me oriente</a>
    </div>
  </div>
</section>

<script is:inline>
const reveals = document.querySelectorAll('[data-reveal]');
const io = new IntersectionObserver((entries)=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:0.08});
reveals.forEach(el=>io.observe(el));

// ===== SERVICE EXPLORER DATA =====
const services = [
  {
    tag: 'ASESORÍA',
    title: 'Asesoría de cambio in situ a prefabricado',
    img: '/img/k-21fdd5a6.jpg',
    bullets: [
      'Optimización del proyecto junto a tu equipo de ingeniería',
      'Transformación de partidas de hormigón in situ a piezas prefabricadas',
      'Ahorro real de tiempo y recursos en obra'
    ]
  },
  {
    tag: 'FABRICACIÓN',
    title: 'Fabricación de piezas de hormigón',
    img: '/img/k-188c1eba.jpg',
    bullets: [
      'Planificación y diseño de estructuras prefabricadas',
      'Montaje seguro en obra por equipo propio',
      'Eficiencia en la instalación, sin tiempos muertos'
    ]
  },
  {
    tag: 'INGENIERÍA',
    title: 'Ingeniería de modulación e izajes',
    img: '/img/k-debd514c.jpg',
    bullets: [
      'Piezas de hormigón hechas a medida según tu ingeniería',
      'Producción con precisión y control de calidad',
      'Fabricación en ambientes controlados de planta'
    ]
  },
  {
    tag: 'LOGÍSTICA',
    title: 'Transporte de piezas de hormigón',
    img: '/img/k-debd514c.jpg',
    bullets: [
      'Transporte seguro y confiable de piezas prefabricadas',
      'Traslado directo desde planta hasta tu proyecto',
      'Garantía de integridad y puntualidad en la entrega'
    ]
  },
  {
    tag: 'MONTAJE',
    title: 'Montaje de piezas en obra',
    img: '/img/k-188c1eba.jpg',
    bullets: [
      'Instalación rápida y precisa de cada componente',
      'Montaje ejecutado por nuestro propio equipo técnico',
      'Optimización del tiempo total de construcción en obra'
    ]
  },
  {
    tag: 'ORNAMENTAL',
    title: 'Piezas ornamentales y áreas verdes',
    img: '/img/k-21fdd5a6.jpg',
    bullets: [
      'Elementos decorativos y funcionales de hormigón',
      'Embellecimiento de espacios exteriores',
      'Refuerzo y delimitación de áreas exteriores'
    ]
  }
];

const waMessages = [
  'Hola Koncreta, quiero evaluar cambiar mi proyecto de in situ a prefabricado',
  'Hola Koncreta, quiero cotizar fabricaci%C3%B3n de piezas de hormig%C3%B3n a medida',
  'Hola Koncreta, quiero consultar por ingenier%C3%ADa de modulaci%C3%B3n e izajes',
  'Hola Koncreta, quiero consultar por transporte de piezas',
  'Hola Koncreta, quiero consultar por montaje de piezas en obra',
  'Hola Koncreta, quiero consultar por piezas ornamentales y de %C3%A1reas verdes'
];

const panel = document.getElementById('explorer-panel');
function renderService(i){
  const s = services[i];
  panel.innerHTML = `
    <div class="ep-media"><span class="ep-tag mono">${s.tag}</span><img src="${s.img}" alt="${s.title}"></div>
    <div class="ep-scope">Alcance del servicio</div>
    <h3>${s.title}</h3>
    <ul>${s.bullets.map(b=>`<li>${b}</li>`).join('')}</ul>
    <div class="ep-cta"><a class="btn btn-primary" href="https://wa.me/56983984326?text=${waMessages[i]}" target="_blank" rel="noopener">Consultar por WhatsApp</a></div>
  `;
}
document.querySelectorAll('.explorer-tab').forEach(tab=>{
  tab.addEventListener('click', ()=>{
    document.querySelectorAll('.explorer-tab').forEach(t=>t.classList.remove('active'));
    tab.classList.add('active');
    renderService(parseInt(tab.dataset.service));
  });
});
renderService(0);

// Diferenciadores accordion
document.querySelectorAll('.diff-full-trigger').forEach(trigger=>{
  trigger.addEventListener('click', ()=>{
    const item = trigger.closest('.diff-full-item');
    const wasOpen = item.classList.contains('open');
    document.querySelectorAll('.diff-full-item').forEach(i=>i.classList.remove('open'));
    if(!wasOpen) item.classList.add('open');
  });
});
</script>
</Base>
