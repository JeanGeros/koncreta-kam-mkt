---
import '../styles/global.css';
import '../styles/proyectos.css';
import Base from '../layouts/Base.astro';
import { getPublishedProjects } from '../lib/projects';
import { PROJECT_CATEGORIES } from '../lib/constants';

const projects = await getPublishedProjects();
---

<Base title="Proyectos Ejecutados — Koncreta Prefabricados">
<!-- ===================== PAGE HERO ===================== -->
<section class="page-hero" id="inicio">
  <div class="container">
    <div class="idx">Casos de éxito</div>
    <h1>Proyectos Ejecutados</h1>
    <p>Soluciones a la medida de tu ingeniería con Rechazo 0 en terreno.</p>
    <div class="rechazo-chip"><b>Rechazo 0</b>&nbsp; en recepción de obra — cumplimiento verificado en cada entrega</div>
  </div>
</section>

<!-- ===================== FILTER BAR ===================== -->
<div class="filter-bar">
  <div class="container">
    <div class="filter-track" id="proyectos-filter-track">
      <span class="filter-chip active" data-cat="todos">Todos</span>
      {PROJECT_CATEGORIES.map((cat) => <span class="filter-chip" data-cat={cat}>{cat}</span>)}
    </div>
  </div>
</div>

<!-- ===================== PORTFOLIO GRID ===================== -->
<section class="portfolio-section" id="proyectos">
  <div class="container">
    <div class="portfolio-grid" id="portfolio-grid" data-reveal>

      {projects.map((p) => (
        <article class="portfolio-card" data-cat={p.category}>
          <div class="portfolio-img">
            <span class="portfolio-tag">{p.category}</span>
            {p.image_url ? (
              <img src={p.image_url} alt={p.image_alt ?? p.title} />
            ) : (
              <div class="ph-industrial"><span>Imagen referencial<br />disponible en levantamiento fotográfico</span></div>
            )}
          </div>
          <div class="portfolio-body">
            <h4>{p.title}</h4>
            <div class="loc">{p.location}</div>
            <ul class="portfolio-bullets">
              {p.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
            <a class="portfolio-cta" href="#form-proyecto">Cotizar un proyecto similar →</a>
          </div>
        </article>
      ))}

    </div>
    <p id="portfolio-empty" style="display:none;color:var(--gris-plata);font-size:0.9rem;padding:40px 0;">No hay proyectos en esta categoría todavía.</p>
  </div>
</section>

<!-- ===================== FORM LEAD-IN ===================== -->
<section class="form-lead">
  <div class="container form-lead-inner">
    <div class="idx" data-reveal>Hablemos de tu proyecto</div>
    <h2 data-reveal>Cotiza la ingeniería de tu proyecto</h2>
    <p data-reveal>Cuéntanos qué necesitas fabricar. La Oficina Técnica revisa tu requerimiento y te responde con una propuesta a medida en menos de 24 horas.</p>
  </div>
</section>

<!-- ===================== FORMULARIO INTEGRADO ===================== -->
<section class="proyectos-form-section" id="form-proyecto">
  <div class="container">
    <form class="proyectos-form-wrap" data-reveal onsubmit="event.preventDefault(); alert('Formulario de demostración — boceto de diseño.');">
      <div class="field"><label for="p-nombre">Nombre</label><input type="text" id="p-nombre" required></div>
      <div class="field"><label for="p-empresa">Empresa</label><input type="text" id="p-empresa" required></div>
      <div class="field"><label for="p-correo">Correo</label><input type="email" id="p-correo" required></div>
      <div class="field"><label for="p-telefono">Teléfono</label><input type="tel" id="p-telefono" required></div>
      <div class="field field-full">
        <label for="p-tipo">Tipo de proyecto</label>
        <select id="p-tipo">
          <option>Fundaciones y pedestales</option>
          <option>Cámaras cilíndricas mineras</option>
          <option>Barreras New Jersey</option>
          <option>Muros y dados de fundación</option>
          <option>Otro / a definir con Oficina Técnica</option>
        </select>
      </div>
      <div class="field field-full">
        <label for="p-mensaje">Detalle de tu requerimiento</label>
        <textarea id="p-mensaje" placeholder="Cantidad de piezas, plazo estimado y planta de despacho preferida"></textarea>
      </div>
      <div class="field field-full">
        <label for="p-planos">Adjuntar planos (opcional)</label>
        <input type="file" id="p-planos">
      </div>
      <div class="submit-row">
        <p class="submit-note">Respuesta de la Oficina Técnica en menos de 24 horas hábiles.</p>
        <button type="submit" class="submit-btn" style="width:auto;padding:16px 34px;">Cotiza la ingeniería de tu proyecto</button>
      </div>
    </form>
  </div>
</section>

<script is:inline>
const reveals = document.querySelectorAll('[data-reveal]');
const io = new IntersectionObserver((entries)=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:0.1});
reveals.forEach(el=>io.observe(el));

const chips = document.querySelectorAll('#proyectos-filter-track .filter-chip');
const cards = document.querySelectorAll('#portfolio-grid .portfolio-card');
const emptyMsg = document.getElementById('portfolio-empty');
chips.forEach(chip=>{
  chip.addEventListener('click', ()=>{
    chips.forEach(c=>c.classList.remove('active'));
    chip.classList.add('active');
    const cat = chip.dataset.cat;
    let visibleCount = 0;
    cards.forEach(card=>{
      const match = cat === 'todos' || card.dataset.cat === cat;
      card.style.display = match ? '' : 'none';
      if(match) visibleCount++;
    });
    emptyMsg.style.display = visibleCount === 0 ? 'block' : 'none';
  });
});
</script>
</Base>
