---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, ORGANIZACION } from '../consts';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	categoryLabel: string;
	/* Ya no se muestra en el post; sigue alimentando og:image y el schema. */
	heroImage?: string | null;
}

const { title, description, pubDate, categoryLabel, heroImage } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const articuloJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	articleSection: categoryLabel,
	image: heroImage ? new URL(heroImage, Astro.site).href : new URL('/img/og-default.jpg', Astro.site).href,
	mainEntityOfPage: canonicalURL.href,
	author: { '@type': 'Organization', name: SITE_TITLE, url: ORGANIZACION.url },
	publisher: { '@id': `${ORGANIZACION.url}/#empresa` },
};
---

<html lang="es">
	<head>
		<BaseHead
			title={`${title} — Koncreta Prefabricados`}
			description={description}
			image={heroImage}
			type="article"
			publishedTime={pubDate.toISOString()}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(articuloJsonLd)} is:inline />
		<style>
			/* El cuerpo va a 18px y no a los 16px heredados del body: a 16px daban
			   ~88 caracteres por linea, sobre el tope de 80 de WCAG 1.4.8; a 18px
			   quedan ~80. El ancho se mantiene en los 720px de siempre. */
			.prose {
				width: 720px;
				max-width: calc(100% - 2.5rem);
				margin: 0 auto;
				padding: 48px 0 90px;
				color: var(--gris-oscuro);
				font-size: 1.125rem;
				line-height: 1.7;
			}
			/* El contenido del post entra por set:html, así que no lleva el
			   atributo de scope de Astro: estas reglas deben ser :global. */
			.prose :global(h1),
			.prose :global(h2),
			.prose :global(h3) {
				color: var(--negro);
				margin: 1.6em 0 0.6em;
			}
			.prose :global(p) {
				margin: 0 0 1.2em;
			}
			.prose :global(ul),
			.prose :global(ol) {
				margin: 0 0 1.2em;
				padding-left: 1.4em;
			}
			.prose :global(li) {
				list-style: initial;
				margin-bottom: 0.5em;
			}
			.prose :global(a) {
				color: var(--naranja);
				text-decoration: underline;
			}
			.prose :global(img),
			.prose :global(video) {
				width: 100%;
				border-radius: 12px;
				margin: 1.6em 0;
			}
			.prose :global([data-columns]) {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 32px;
				margin: 1.6em 0;
				align-items: start;
			}
			/* min-width:0 evita que una imagen o palabra larga desborde la columna */
			.prose :global([data-column]) {
				min-width: 0;
			}
			.prose :global([data-column] > :last-child) {
				margin-bottom: 0;
			}
			/* Sin esto un h2 al inicio de columna cae desfasado respecto a la
			   imagen de la columna vecina, por su margin-top. */
			.prose :global([data-column] > :first-child) {
				margin-top: 0;
			}
			.prose :global([data-column] img) {
				margin: 0 0 1em;
			}
			@media (max-width: 640px) {
				.prose :global([data-columns]) {
					grid-template-columns: 1fr;
					gap: 20px;
				}
			}
			/* 760 = los 720px de .prose + los 20px de padding de cada lado. Antes
			   estaba en 720 y el titulo quedaba 40px mas angosto que el cuerpo. */
			.title {
				max-width: 760px;
				margin: 0 auto;
				padding: 48px 20px 0;
			}
			.title .fb-tag {
				color: var(--naranja);
				font-family: 'Century Gothic', sans-serif;
				font-weight: 700;
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}
			.title h1 {
				font-size: clamp(1.8rem, 4vw, 2.6rem);
				margin: 14px 0 12px;
				line-height: 1.15;
			}
			.date {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.78rem;
				color: var(--gris-plata);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="title">
					<span class="fb-tag">{categoryLabel}</span>
					<h1>{title}</h1>
					<div class="date"><FormattedDate date={pubDate} /></div>
				</div>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
