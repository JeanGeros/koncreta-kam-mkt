# Conexión a la base de datos (inyectada por la integración Postgres/Neon de Vercel)
DATABASE_URL=

# Token de acceso a Vercel Blob (inyectado por la integración Blob de Vercel)
BLOB_READ_WRITE_TOKEN=

# String aleatorio para firmar las cookies de sesión del admin. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
