# ==========================================
# KONCRETA PREFABRICADOS - VARIABLES DE ENTORNO
# ==========================================

# 1. Base de Datos (PostgreSQL - Supabase / Neon / Railway / Vercel Postgres)
# String de conexión con SSL obligatorio (ssl: 'require').
DATABASE_URL="postgresql://usuario:password@host:port/database?sslmode=require"

# 2. Seguridad de Sesión Admin
# Clave secreta para firmar cookies HMAC de sesión del panel /admin (mínimo 32 caracteres).
SESSION_SECRET="generar_clave_secreta_aleatoria_de_32_caracteres_o_mas"

# 3. Almacenamiento Multimedia (Vercel Blob Store)
# Token de acceso para subir fotos optimizadas en WebP y videos desde el admin.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# 4. Anti-Spam / Captcha (Cloudflare Turnstile)
# Widget de verificación invisible/interactivo para formularios de contacto y proyectos.
PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAxxxxxxxxxxxxxxxx"
TURNSTILE_SECRET_KEY="0x4AAAAAAxxxxxxxxxxxxxxxx"

# 5. Envío de Correos (SMTP - Nodemailer)
# Configuración del servidor de correo para notificaciones de cotizaciones y newsletter.
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
SMTP_USER="notificaciones@koncretaprefabricados.cl"
SMTP_PASS="password_o_app_password"
CONTACT_FROM="Koncreta Prefabricados <notificaciones@koncretaprefabricados.cl>"
CONTACT_TO="viveka.guarino@koncretaprefabricados.cl"

# 6. Mantenimiento y Desarrollo (Opcional)
# Si es "true", muestra pantalla de mantenimiento en rutas públicas (/admin sigue accesible).
MAINTENANCE_MODE=false

# Bypass de autenticación SOLO para desarrollo local (`astro dev`)
ADMIN_DEV_BYPASS=false
