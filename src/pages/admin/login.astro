---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { actions } from 'astro:actions';
import { Icon } from 'astro-icon/components';

const result = Astro.getActionResult(actions.login);
if (result && !result.error) {
	return Astro.redirect('/admin');
}

---

<AdminLayout title="Iniciar sesión">
	<div class="login-wrap">
		<div class="login-shell">
			<div class="login-brand">
				<span class="name">Koncreta</span>
				<span class="tag">Acceso al sistema</span>
			</div>
			<div class="login-card">
				{result?.error && <p class="action-error">{result.error.message}</p>}
				<form method="POST" action={actions.login} class="admin-form" id="login-form">
					<div class="field">
						<label for="email">Correo</label>
						<div class="input-icon">
							<Icon name="material-symbols:person" class="icon" />
							<input type="email" id="email" name="email" placeholder="correo@koncretaprefabricados.cl" required autofocus />
						</div>
					</div>
					<div class="field">
						<div class="field-label-row">
							<label for="password">Contraseña</label>
							<button type="button" id="open-reset-modal" class="reset-link">Restablecer clave</button>
						</div>
						<div class="input-icon">
							<Icon name="material-symbols:key" class="icon" />
							<input type="password" id="password" name="password" required />
							<button type="button" id="toggle-password" aria-label="Mostrar contraseña">
								<span data-eye-on><Icon name="material-symbols:visibility" class="icon" /></span>
								<span data-eye-off hidden><Icon name="material-symbols:visibility-off" class="icon" /></span>
							</button>
						</div>
					</div>
					<div class="field checkbox-field">
						<input type="checkbox" id="remember" name="remember" checked />
						<label for="remember" style="margin:0;">Mantener sesión activa</label>
					</div>
					<button type="submit" class="btn btn-primary" style="width:100%;margin-top:4px;">
						Ingresar
						<Icon name="material-symbols:arrow-forward" class="icon" style="width:18px;height:18px;" />
					</button>
				</form>
			</div>
			<div class="login-meta">Conexión segura // Acceso restringido</div>
		</div>
	</div>

	<!-- Modal de Restablecimiento de Contraseña -->
	<div class="modal-backdrop" id="reset-modal" hidden>
		<div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="reset-modal-title">
			<button type="button" class="modal-close" id="close-reset-modal" aria-label="Cerrar modal">
				<Icon name="material-symbols:close" class="icon" />
			</button>

			<!-- Vista 1: Formulario de solicitud -->
			<div id="reset-view-form">
				<div class="modal-header">
					<div class="modal-icon-wrap">
						<Icon name="material-symbols:lock-reset" class="icon modal-brand-icon" />
					</div>
					<h3 id="reset-modal-title" class="modal-title">Restablecer contraseña</h3>
					<p class="modal-subtitle">
						Ingresa tu correo registrado y te enviaremos un enlace seguro para crear tu nueva clave.
					</p>
				</div>

				<form id="reset-form" class="admin-form" style="margin-top:20px;">
					<div id="reset-error" class="action-error" style="display:none;margin-bottom:16px;"></div>
					<div class="field">
						<label for="reset-email">Correo registrado</label>
						<div class="input-icon">
							<Icon name="material-symbols:mail" class="icon" />
							<input type="email" id="reset-email" name="email" placeholder="correo@koncretaprefabricados.cl" required />
						</div>
					</div>
					<div class="modal-actions">
						<button type="button" class="btn btn-outline-dark" id="cancel-reset-modal" style="flex:1;">Cancelar</button>
						<button type="submit" class="btn btn-primary" id="btn-submit-reset" style="flex:1.4;">
							<span id="btn-submit-text">Enviar enlace</span>
							<Icon name="material-symbols:send" class="icon" id="btn-submit-icon" style="width:16px;height:16px;" />
						</button>
					</div>
				</form>
			</div>

			<!-- Vista 2: Confirmación de envío -->
			<div id="reset-view-success" hidden>
				<div class="modal-header">
					<div class="modal-icon-wrap success-icon-wrap">
						<Icon name="material-symbols:mark-email-read" class="icon success-icon" />
					</div>
					<h3 class="modal-title">¡Correo enviado!</h3>
					<p class="modal-subtitle">
						Hemos enviado las instrucciones a <strong id="success-target-email" style="color:var(--negro);"></strong>. Revisa tu bandeja de entrada o carpeta de spam para continuar.
					</p>
				</div>
				<div class="modal-actions" style="margin-top:24px;">
					<button type="button" class="btn btn-primary" id="btn-dismiss-success" style="width:100%;">
						Entendido, volver al login
					</button>
				</div>
			</div>
		</div>
	</div>
</AdminLayout>

<script>
	import { actions } from 'astro:actions';

	// Toggle ver/ocultar contraseña en login
	const toggleBtn = document.getElementById('toggle-password');
	const passwordInput = document.getElementById('password') as HTMLInputElement | null;
	if (toggleBtn && passwordInput) {
		const eyeOn = toggleBtn.querySelector('[data-eye-on]') as HTMLElement | null;
		const eyeOff = toggleBtn.querySelector('[data-eye-off]') as HTMLElement | null;
		toggleBtn.addEventListener('click', () => {
			const isPassword = passwordInput.getAttribute('type') === 'password';
			passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
			if (eyeOn) eyeOn.hidden = isPassword;
			if (eyeOff) eyeOff.hidden = !isPassword;
		});
	}

	// Modal de recuperación de contraseña
	const resetModal = document.getElementById('reset-modal') as HTMLElement | null;
	const openModalBtn = document.getElementById('open-reset-modal');
	const closeModalBtn = document.getElementById('close-reset-modal');
	const cancelModalBtn = document.getElementById('cancel-reset-modal');
	const dismissSuccessBtn = document.getElementById('btn-dismiss-success');

	const loginEmailInput = document.getElementById('email') as HTMLInputElement | null;
	const resetEmailInput = document.getElementById('reset-email') as HTMLInputElement | null;
	const resetForm = document.getElementById('reset-form') as HTMLFormElement | null;
	const resetErrorEl = document.getElementById('reset-error') as HTMLElement | null;
	const btnSubmitReset = document.getElementById('btn-submit-reset') as HTMLButtonElement | null;
	const btnSubmitText = document.getElementById('btn-submit-text') as HTMLElement | null;

	const viewForm = document.getElementById('reset-view-form') as HTMLElement | null;
	const viewSuccess = document.getElementById('reset-view-success') as HTMLElement | null;
	const successTargetEmail = document.getElementById('success-target-email') as HTMLElement | null;

	function openModal() {
		if (!resetModal) return;
		// Precargar email si ya se había escrito en el login
		if (loginEmailInput && resetEmailInput && loginEmailInput.value) {
			resetEmailInput.value = loginEmailInput.value;
		}
		if (resetErrorEl) {
			resetErrorEl.style.display = 'none';
			resetErrorEl.textContent = '';
		}
		if (viewForm) viewForm.hidden = false;
		if (viewSuccess) viewSuccess.hidden = true;
		resetModal.hidden = false;
		setTimeout(() => resetEmailInput?.focus(), 50);
	}

	function closeModal() {
		if (!resetModal) return;
		resetModal.hidden = true;
		if (resetErrorEl) resetErrorEl.style.display = 'none';
	}

	openModalBtn?.addEventListener('click', (e) => {
		e.preventDefault();
		openModal();
	});

	closeModalBtn?.addEventListener('click', closeModal);
	cancelModalBtn?.addEventListener('click', closeModal);
	dismissSuccessBtn?.addEventListener('click', closeModal);

	// Cerrar al hacer clic en el backdrop
	resetModal?.addEventListener('click', (e) => {
		if (e.target === resetModal) {
			closeModal();
		}
	});

	// Cerrar con Escape
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && resetModal && !resetModal.hidden) {
			closeModal();
		}
	});

	// Enviar solicitud de recuperación
	resetForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (!btnSubmitReset || !btnSubmitText) return;

		const email = resetEmailInput?.value.trim() || '';
		if (!email) return;

		btnSubmitReset.disabled = true;
		btnSubmitText.textContent = 'Enviando…';
		if (resetErrorEl) resetErrorEl.style.display = 'none';

		try {
			const { error } = await actions.requestPasswordReset(new FormData(resetForm));
			if (error) {
				if (resetErrorEl) {
					resetErrorEl.textContent = error.message || 'Ocurrió un error al enviar el correo.';
					resetErrorEl.style.display = 'block';
				}
				btnSubmitReset.disabled = false;
				btnSubmitText.textContent = 'Enviar enlace';
			} else {
				if (successTargetEmail) successTargetEmail.textContent = email;
				if (viewForm) viewForm.hidden = true;
				if (viewSuccess) viewSuccess.hidden = false;
				btnSubmitReset.disabled = false;
				btnSubmitText.textContent = 'Enviar enlace';
			}
		} catch (err) {
			if (resetErrorEl) {
				resetErrorEl.textContent = 'No se pudo conectar con el servidor. Inténtalo de nuevo.';
				resetErrorEl.style.display = 'block';
			}
			btnSubmitReset.disabled = false;
			btnSubmitText.textContent = 'Enviar enlace';
		}
	});
</script>

<style>
	.login-card .field .input-icon button {
		position: absolute;
		right: 13px;
		top: 50%;
		transform: translateY(-50%);
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		color: var(--gris-plata);
		display: flex;
	}
	.login-card .field .input-icon input {
		padding-right: 38px;
	}
	.reset-link {
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
	}

	/* Modal Backdrop & Dialog */
	.modal-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(38, 24, 19, 0.65);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 20px;
		z-index: 100;
		animation: fadeIn 0.2s ease-out;
	}
	.modal-backdrop[hidden] {
		display: none;
	}
	.modal-dialog {
		background: var(--a-white);
		border-radius: 24px;
		padding: 36px 32px 32px;
		max-width: 440px;
		width: 100%;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
		position: relative;
		animation: scaleUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.modal-close {
		position: absolute;
		top: 18px;
		right: 18px;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 50%;
		width: 34px;
		height: 34px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--gris-plata);
		cursor: pointer;
		transition: all 0.15s ease;
	}
	.modal-close:hover {
		color: var(--negro);
		background: var(--a-surface-variant);
	}
	.modal-header {
		text-align: center;
	}
	.modal-icon-wrap {
		width: 54px;
		height: 54px;
		border-radius: 50%;
		background: var(--a-surface-variant);
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 16px;
	}
	.modal-brand-icon {
		width: 28px;
		height: 28px;
		color: var(--naranja);
	}
	.success-icon-wrap {
		background: #e6f7ed;
	}
	.success-icon {
		width: 28px;
		height: 28px;
		color: #15803d;
	}
	.modal-title {
		font-size: 1.35rem;
		font-weight: 700;
		color: var(--negro);
		margin: 0 0 8px;
		font-family: 'Hanken Grotesk', sans-serif;
	}
	.modal-subtitle {
		font-size: 0.88rem;
		color: var(--gris-oscuro);
		line-height: 1.5;
		margin: 0;
	}
	.modal-actions {
		display: flex;
		gap: 10px;
		margin-top: 20px;
	}

	@keyframes fadeIn {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	@keyframes scaleUp {
		from { opacity: 0; transform: scale(0.95) translateY(10px); }
		to { opacity: 1; transform: scale(1) translateY(0); }
	}
</style>
