---
export const prerender = true;

import Base from '../layouts/Base.astro';
import MapasPlantas from '../components/MapasPlantas.astro';
import { getPublishedProjects } from '../lib/projects';

// El selector mostraba 4 proyectos escritos a mano que ya no existen. Ahora
// sale de la base: un proyecto por categoria, que mantiene el mismo formato.
// try/catch porque la pagina es prerenderizada: sin el, una base caida al
// momento del build tumba el deploy entero.
let selectorProjects: { tag: string; title: string; desc: string; img: string | null }[] = [];
try {
	const porCategoria = new Map<string, (typeof selectorProjects)[number]>();
	for (const p of await getPublishedProjects()) {
		if (porCategoria.has(p.category)) continue; // el primero de cada una
		porCategoria.set(p.category, {
			tag: p.category.toUpperCase(),
			title: p.title,
			desc: p.bullets?.[0] ?? '',
			img: p.image_url,
		});
	}
	selectorProjects = [...porCategoria.values()];
} catch (e) {
	console.warn('No se pudieron cargar los proyectos del selector:', e);
}
