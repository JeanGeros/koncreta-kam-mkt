---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { actions } from 'astro:actions';
import { PROJECT_CATEGORIES } from '../../../lib/constants';
import { getProjectById } from '../../../lib/projects';

const id = Number(Astro.params.id);
const result = Astro.getActionResult(actions.updateProject);
if (result && !result.error) {
	return Astro.redirect('/admin/proyectos');
}

const project = await getProjectById(id);
if (!project) {
	return new Response(null, { status: 404 });
}
---

<AdminLayout title={`Editar: ${project.title}`}>
	<div class="admin-head">
		<div>
			<div class="idx">Proyectos</div>
			<h1>Editar proyecto</h1>
		</div>
	</div>
	{result?.error && <p class="action-error">{result.error.message}</p>}
	<div class="admin-card">
		<form method="POST" action={actions.updateProject} enctype="multipart/form-data" class="admin-form">
			<input type="hidden" name="id" value={project.id} />
			<input type="hidden" name="existing_image_url" value={project.image_url ?? ''} />
			<div class="field">
				<label for="title">Título</label>
				<input type="text" id="title" name="title" required value={project.title} />
			</div>
			<div class="field-row">
				<div class="field">
					<label for="category">Categoría</label>
					<select id="category" name="category" required>
						{PROJECT_CATEGORIES.map((c) => (
							<option value={c} selected={c === project.category}>{c}</option>
						))}
					</select>
				</div>
				<div class="field">
					<label for="location">Ubicación</label>
					<input type="text" id="location" name="location" required value={project.location} />
				</div>
			</div>
			<div class="field">
				<label for="bullets">Detalles (uno por línea)</label>
				<textarea id="bullets" name="bullets" rows="5" required>{project.bullets.join('\n')}</textarea>
			</div>
			<div class="field">
				{project.image_url && <img src={project.image_url} alt="" class="current-image" />}
				<label for="image">Reemplazar imagen</label>
				<input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp" />
				<p class="field-hint">Deja vacío para mantener la imagen actual. JPG, PNG o WebP, máx. 5MB.</p>
			</div>
			<div class="field">
				<label for="image_alt">Texto alternativo de la imagen</label>
				<input type="text" id="image_alt" name="image_alt" value={project.image_alt ?? ''} />
			</div>
			<div class="field-row">
				<div class="field">
					<label for="sort_order">Orden</label>
					<input type="number" id="sort_order" name="sort_order" value={project.sort_order} />
				</div>
				<div class="field checkbox-field" style="align-self:end;padding-bottom:13px;">
					<input type="checkbox" id="published" name="published" checked={project.published} />
					<label for="published" style="margin:0;">Publicado</label>
				</div>
			</div>
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">Guardar cambios</button>
				<a href="/admin/proyectos" class="btn btn-outline-dark">Cancelar</a>
			</div>
		</form>
	</div>
</AdminLayout>
