# Connection string de Postgres (cualquier proveedor: Supabase, Neon, RDS, local...).
# En Supabase: Project Settings → Database → Connection string → "Transaction pooler"
# (puerto 6543) es el recomendado para funciones serverless de Vercel.
DATABASE_URL=

# Token de acceso a Vercel Blob (inyectado por la integración Blob de Vercel)
BLOB_READ_WRITE_TOKEN=

# String aleatorio para firmar las cookies de sesión del admin. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Cloudflare Turnstile (captcha de los formularios públicos). Estas son las
# claves de prueba de Cloudflare que siempre aprueban; reemplazar por las reales.
# La site key es pública y se incrusta en el build (las páginas son estáticas).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# SMTP para el envío de los formularios. Puerto 465 = SSL, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Destinatario(s), separados por coma.
CONTACT_TO=jea.gonzaleza@gmail.com
# Remitente. Si se omite usa SMTP_USER. Muchos servidores exigen que coincida.
CONTACT_FROM=
