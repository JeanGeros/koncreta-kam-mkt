---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { actions } from 'astro:actions';
import { Icon } from 'astro-icon/components';

const result = Astro.getActionResult(actions.updatePassword);
let success = false;
if (result && !result.error) {
	success = true;
}
---

<AdminLayout title="Crear nueva contraseña">
	<div class="login-wrap">
		<div class="login-shell">
			<div class="login-brand">
				<span class="name">Koncreta</span>
				<span class="tag">Restablecimiento de seguridad</span>
			</div>
			<div class="login-card">
				{
					success ? (
						<div style="text-align:center;padding:10px 0;">
							<div class="success-icon-badge">
								<Icon name="material-symbols:check-circle" class="icon" style="width:30px;height:30px;" />
							</div>
							<h2 style="font-size:1.35rem;margin-bottom:8px;color:var(--negro);">Contraseña actualizada</h2>
							<p style="font-size:0.88rem;color:var(--gris-oscuro);line-height:1.5;margin-bottom:24px;">
								Tu contraseña ha sido restablecida exitosamente. Ya puedes acceder al panel de administración.
							</p>
							<a href="/admin" class="btn btn-primary" style="width:100%;">
								Ir al panel
								<Icon name="material-symbols:arrow-forward" class="icon" style="width:18px;height:18px;" />
							</a>
						</div>
					) : (
						<>
							{result?.error && <p class="action-error">{result.error.message}</p>}
							<p style="font-size:0.86rem;color:var(--gris-oscuro);line-height:1.5;margin-bottom:20px;">
								Ingresa tu nueva clave de acceso para proteger tu cuenta.
							</p>
							<form method="POST" action={actions.updatePassword} class="admin-form">
								<div class="field">
									<label for="password">Nueva contraseña</label>
									<div class="input-icon">
										<Icon name="material-symbols:lock" class="icon" />
										<input type="password" id="password" name="password" minlength="6" placeholder="Mínimo 6 caracteres" required autofocus />
									</div>
								</div>
								<div class="field">
									<label for="password_confirm">Confirmar nueva contraseña</label>
									<div class="input-icon">
										<Icon name="material-symbols:lock-reset" class="icon" />
										<input type="password" id="password_confirm" name="password_confirm" minlength="6" placeholder="Repite tu contraseña" required />
									</div>
								</div>
								<button type="submit" class="btn btn-primary" style="width:100%;margin-top:8px;">
									Guardar nueva contraseña
									<Icon name="material-symbols:check" class="icon" style="width:18px;height:18px;" />
								</button>
							</form>
						</>
					)
				}
			</div>
			<div class="login-meta">
				<a href="/admin/login" style="color:var(--gris-plata);text-decoration:none;transition:color .2s;">← Volver al inicio de sesión</a>
			</div>
		</div>
	</div>
</AdminLayout>

<style>
	.success-icon-badge {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: var(--a-surface-variant);
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 18px;
		color: var(--naranja);
	}
	.login-meta a:hover {
		color: var(--naranja);
	}
</style>
