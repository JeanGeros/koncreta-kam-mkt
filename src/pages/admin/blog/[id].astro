---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { actions } from 'astro:actions';
import { BLOG_CATEGORIES } from '../../../lib/constants';
import { getPostById } from '../../../lib/blog';

const id = Number(Astro.params.id);
const result = Astro.getActionResult(actions.updatePost);
if (result && !result.error) {
	return Astro.redirect('/admin/blog');
}

const post = await getPostById(id);
if (!post) {
	return new Response(null, { status: 404 });
}
---

<AdminLayout title={`Editar: ${post.title}`}>
	<div class="admin-head">
		<h1>Editar post</h1>
	</div>
	{result?.error && <p class="action-error">{result.error.message}</p>}
	<div class="admin-card">
		<form method="POST" action={actions.updatePost} enctype="multipart/form-data" class="admin-form">
			<input type="hidden" name="id" value={post.id} />
			<input type="hidden" name="existing_hero_image_url" value={post.hero_image_url ?? ''} />
			<div class="field">
				<label for="title">Título</label>
				<input type="text" id="title" name="title" required value={post.title} />
			</div>
			<div class="field">
				<label for="category">Categoría</label>
				<select id="category" name="category" required>
					{BLOG_CATEGORIES.map((c) => (
						<option value={c.value} selected={c.value === post.category}>{c.label}</option>
					))}
				</select>
			</div>
			<div class="field">
				<label for="excerpt">Extracto (resumen corto)</label>
				<textarea id="excerpt" name="excerpt" rows="2" required>{post.excerpt}</textarea>
			</div>
			<div class="field">
				<label for="content">Contenido (Markdown)</label>
				<textarea id="content" name="content" rows="14" required>{post.content}</textarea>
				<p class="field-hint">Soporta Markdown: títulos con #, listas con -, negritas con **texto**.</p>
			</div>
			<div class="field">
				{post.hero_image_url && <img src={post.hero_image_url} alt="" class="current-image" />}
				<label for="hero_image">Reemplazar imagen principal</label>
				<input type="file" id="hero_image" name="hero_image" accept="image/jpeg,image/png,image/webp" />
				<p class="field-hint">Deja vacío para mantener la imagen actual. JPG, PNG o WebP, máx. 5MB.</p>
			</div>
			<div class="field">
				<label for="hero_image_alt">Texto alternativo de la imagen</label>
				<input type="text" id="hero_image_alt" name="hero_image_alt" value={post.hero_image_alt ?? ''} />
			</div>
			<div class="field checkbox-field">
				<input type="checkbox" id="featured" name="featured" checked={post.featured} />
				<label for="featured" style="margin:0;">Destacado (aparece como post principal del blog)</label>
			</div>
			<div class="field checkbox-field">
				<input type="checkbox" id="published" name="published" checked={post.published} />
				<label for="published" style="margin:0;">Publicado</label>
			</div>
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">Guardar cambios</button>
				<a href="/admin/blog">Cancelar</a>
			</div>
		</form>
	</div>
</AdminLayout>
