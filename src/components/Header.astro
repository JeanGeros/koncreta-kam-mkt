---
// Styles live in src/styles/global.css (header rules copied verbatim from the template).

const nav = [
	{ href: '/', label: 'Inicio' },
	{ href: '/servicios', label: 'Servicios' },
	{ href: '/proyectos', label: 'Proyectos' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/contacto', label: 'Contacto' },
];
---

<header>
	<div class="header-inner">
		<a href="/" class="logo">
			<img src="/logo-lockup.png" alt="Koncreta Prefabricados" width="379" height="146" />
		</a>
		<nav class="desktop-nav">
			<ul>
				{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
			</ul>
		</nav>
		<a href="/contacto" class="header-cta">Cotiza tu proyecto</a>
		<button
			class="burger"
			onclick="document.querySelector('.mobile-menu').classList.toggle('open')"
			aria-label="Abrir menú">☰</button
		>
	</div>
	<div class="mobile-menu">
		{nav.map((item) => <a href={item.href}>{item.label}</a>)}
		<a href="/contacto" class="header-cta">Cotiza tu proyecto</a>
	</div>
</header>
