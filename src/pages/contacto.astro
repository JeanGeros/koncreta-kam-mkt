---
import '../styles/global.css';
import '../styles/contacto.css';
import Base from '../layouts/Base.astro';
---

<Base title="Contacto — Koncreta Prefabricados">
<!-- ===================== CONTACT HERO + FORM (split minimal) ===================== -->
<section class="contact-hero" id="inicio">
  <div class="container">
    <div class="contact-hero-grid">

      <div class="contact-hero-left" data-reveal>
        <div class="idx">Contacto</div>
        <h1><svg viewBox="0 0 24 24"><path d="M8 5l10 7-10 7z"/></svg>Déjanos tus datos<br>y cotiza tu Proyecto</h1>
        <p class="sub">También puedes contactarnos directamente por WhatsApp, sin esperar la respuesta del formulario.</p>

        <a class="wa-pill-btn" href="https://wa.me/56983984326" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.9 1-.4.2-.6.1a6.7 6.7 0 0 1-2-1.2 7.4 7.4 0 0 1-1.4-1.7c-.1-.2 0-.4.1-.5s.2-.3.4-.4.2-.2.3-.4a.5.5 0 0 0 0-.5c-.1-.1-.6-1.5-.8-2s-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.1 5 5 0 0 0 1.1 2.7 11.4 11.4 0 0 0 4.4 3.9c1.5.6 2.1.7 2.9.6a2.5 2.5 0 0 0 1.6-1.1 1.9 1.9 0 0 0 .1-1.1c-.1-.1-.2-.2-.5-.3z"/></svg>
          Escríbenos por WhatsApp
        </a>

        <div class="social-row">
          <a href="https://www.instagram.com/koncreta_prefabricados" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24"><path d="M12 2c-2.7 0-3.06.01-4.12.06-1.06.05-1.79.22-2.43.47-.66.26-1.22.6-1.77 1.16A4.9 4.9 0 0 0 2.53 5.5c-.25.64-.42 1.37-.47 2.43C2.01 8.99 2 9.35 2 12s.01 3.01.06 4.07c.05 1.06.22 1.79.47 2.43.26.66.6 1.22 1.16 1.77.55.56 1.11.9 1.77 1.16.64.25 1.37.42 2.43.47C8.94 21.99 9.3 22 12 22s3.06-.01 4.12-.06c1.06-.05 1.79-.22 2.43-.47.66-.26 1.22-.6 1.77-1.16.56-.55.9-1.11 1.16-1.77.25-.64.42-1.37.47-2.43.05-1.06.06-1.42.06-4.11s-.01-3.06-.06-4.12c-.05-1.06-.22-1.79-.47-2.43a4.9 4.9 0 0 0-1.16-1.77 4.9 4.9 0 0 0-1.77-1.16c-.64-.25-1.37-.42-2.43-.47C15.06 2.01 14.7 2 12 2zm0 1.8c2.65 0 2.97.01 4.02.06.97.04 1.5.2 1.85.34.46.18.79.39 1.14.74.35.35.56.68.74 1.14.14.35.3.88.34 1.85.05 1.05.06 1.37.06 4.02s-.01 2.97-.06 4.02c-.04.97-.2 1.5-.34 1.85-.18.46-.39.79-.74 1.14-.35.35-.68.56-1.14.74-.35.14-.88.3-1.85.34-1.05.05-1.37.06-4.02.06s-2.97-.01-4.02-.06c-.97-.04-1.5-.2-1.85-.34a3.1 3.1 0 0 1-1.14-.74 3.1 3.1 0 0 1-.74-1.14c-.14-.35-.3-.88-.34-1.85-.05-1.05-.06-1.37-.06-4.02s.01-2.97.06-4.02c.04-.97.2-1.5.34-1.85.18-.46.39-.79.74-1.14.35-.35.68-.56 1.14-.74.35-.14.88-.3 1.85-.34C9.03 3.81 9.35 3.8 12 3.8zm0 3.06a5.14 5.14 0 1 0 0 10.28 5.14 5.14 0 0 0 0-10.28zm0 8.47a3.33 3.33 0 1 1 0-6.66 3.33 3.33 0 0 1 0 6.66zm6.54-8.68a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z"/></svg>
          </a>
          <a href="https://www.facebook.com/koncretaprefabricados" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
          </a>
          <a href="https://www.linkedin.com/search/results/all/?keywords=koncreta%20prefabricados" target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24"><path d="M4.98 3.5C4.98 4.88 3.94 6 2.5 6S0 4.88 0 3.5 1.06 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4V24h-4V8zm7.5 0h3.8v2.2h.05c.53-1 1.83-2.2 3.77-2.2 4.03 0 4.78 2.65 4.78 6.1V24h-4v-7.7c0-1.84-.03-4.2-2.56-4.2-2.57 0-2.96 2-2.96 4.07V24h-4V8z"/></svg>
          </a>
        </div>
      </div>

      <div data-reveal>
        <div class="form-card-minimal">
          <div class="fc-label">Ponte en contacto con nosotros</div>
          <form onsubmit="event.preventDefault(); alert('Formulario de demostración — boceto de diseño.');">
            <div class="uline-row">
              <div class="uline-field"><label>Nombre <span class="req">*</span></label><input type="text" required></div>
              <div class="uline-field"><label>Empresa</label><input type="text"></div>
            </div>
            <div class="uline-row">
              <div class="uline-field"><label>Email <span class="req">*</span></label><input type="email" required></div>
              <div class="uline-field"><label>Teléfono</label><input type="tel"></div>
            </div>
            <div class="uline-field"><label>Escribe un mensaje</label><textarea placeholder="Cuéntanos sobre tu proyecto: tipo de pieza, cantidad y plazo estimado"></textarea></div>
            <div class="uline-field file-field">
              <label>Adjuntar planos o memorias de cálculo</label>
              <div class="fh">Opcional — formatos PDF, DWG o imagen</div>
              <input type="file">
            </div>
            <button type="submit" class="uline-submit">Enviar</button>
          </form>

          <div class="form-below-contact">
            <div class="fbc-item">
              <span class="fbc-i"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.9 15.9 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.2 11 11 0 0 0 3.5.6 1 1 0 0 1 1 1v3.4a1 1 0 0 1-1 1A18 18 0 0 1 2 3a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11 11 0 0 0 .6 3.5 1 1 0 0 1-.2 1z"/></svg></span>
              <div><a href="tel:+56983984326">+56 9 8398 4326</a><a href="tel:+56985540488">+56 9 8554 0488</a></div>
            </div>
            <div class="fbc-item">
              <span class="fbc-i"><svg viewBox="0 0 24 24"><path d="M2 4h20v16H2V4zm2 2v.01L12 12l8-5.99V6H4zm16 2.24l-7.4 5.55a1 1 0 0 1-1.2 0L4 8.24V18h16V8.24z"/></svg></span>
              <div><a href="mailto:viveka.guarino@koncretaprefabricados.cl">viveka.guarino@koncretaprefabricados.cl</a></div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ===================== SOCIAL STRIP ===================== -->
<section class="social-strip">
  <div class="container">
    <div class="social-strip-inner" data-reveal>
      <div>
        <span class="ss-label">Síguenos</span>
        <h3 class="ss-title">Conecta con Koncreta</h3>
      </div>
      <div class="social-strip-icons">
        <a href="https://www.instagram.com/koncreta_prefabricados" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24"><path d="M12 2c-2.7 0-3.06.01-4.12.06-1.06.05-1.79.22-2.43.47-.66.26-1.22.6-1.77 1.16A4.9 4.9 0 0 0 2.53 5.5c-.25.64-.42 1.37-.47 2.43C2.01 8.99 2 9.35 2 12s.01 3.01.06 4.07c.05 1.06.22 1.79.47 2.43.26.66.6 1.22 1.16 1.77.55.56 1.11.9 1.77 1.16.64.25 1.37.42 2.43.47C8.94 21.99 9.3 22 12 22s3.06-.01 4.12-.06c1.06-.05 1.79-.22 2.43-.47.66-.26 1.22-.6 1.77-1.16.56-.55.9-1.11 1.16-1.77.25-.64.42-1.37.47-2.43.05-1.06.06-1.42.06-4.11s-.01-3.06-.06-4.12c-.05-1.06-.22-1.79-.47-2.43a4.9 4.9 0 0 0-1.16-1.77 4.9 4.9 0 0 0-1.77-1.16c-.64-.25-1.37-.42-2.43-.47C15.06 2.01 14.7 2 12 2zm0 1.8c2.65 0 2.97.01 4.02.06.97.04 1.5.2 1.85.34.46.18.79.39 1.14.74.35.35.56.68.74 1.14.14.35.3.88.34 1.85.05 1.05.06 1.37.06 4.02s-.01 2.97-.06 4.02c-.04.97-.2 1.5-.34 1.85-.18.46-.39.79-.74 1.14-.35.35-.68.56-1.14.74-.35.14-.88.3-1.85.34-1.05.05-1.37.06-4.02.06s-2.97-.01-4.02-.06c-.97-.04-1.5-.2-1.85-.34a3.1 3.1 0 0 1-1.14-.74 3.1 3.1 0 0 1-.74-1.14c-.14-.35-.3-.88-.34-1.85-.05-1.05-.06-1.37-.06-4.02s.01-2.97.06-4.02c.04-.97.2-1.5.34-1.85.18-.46.39-.79.74-1.14.35-.35.68-.56 1.14-.74.35-.14.88-.3 1.85-.34C9.03 3.81 9.35 3.8 12 3.8zm0 3.06a5.14 5.14 0 1 0 0 10.28 5.14 5.14 0 0 0 0-10.28zm0 8.47a3.33 3.33 0 1 1 0-6.66 3.33 3.33 0 0 1 0 6.66zm6.54-8.68a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z"/></svg>
          <span>Instagram</span>
        </a>
        <a href="https://www.facebook.com/koncretaprefabricados" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
          <span>Facebook</span>
        </a>
        <a href="https://www.linkedin.com/search/results/all/?keywords=koncreta%20prefabricados" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24"><path d="M4.98 3.5C4.98 4.88 3.94 6 2.5 6S0 4.88 0 3.5 1.06 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4V24h-4V8zm7.5 0h3.8v2.2h.05c.53-1 1.83-2.2 3.77-2.2 4.03 0 4.78 2.65 4.78 6.1V24h-4v-7.7c0-1.84-.03-4.2-2.56-4.2-2.57 0-2.96 2-2.96 4.07V24h-4V8z"/></svg>
          <span>LinkedIn</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ===================== MAPAS DE PLANTAS ===================== -->
<section class="contact-maps mapas" id="plantas">
  <div class="container">
    <div class="idx" data-reveal>Ubicaciones</div>
    <div class="section-head" data-reveal><h3>Nuestras plantas</h3></div>
    <div class="mapas-grid" data-reveal>
      <div class="mapa-card">
        <div class="mapa-head"><h4>Planta Antofagasta</h4><span class="mono">Km 12, Antofagasta</span></div>
        <div class="mapa-frame"><img src="/img/k-ce9b16b8.jpg" alt="Mapa de ubicación de Planta Antofagasta, Koncreta Prefabricados, Km 12" style="width:100%;height:100%;object-fit:cover;"></div>
        <div style="padding:16px 24px;border-top:1px solid var(--line-dark);"><a href="https://www.google.com/maps/search/?api=1&query=Km+12+Antofagasta+Chile" target="_blank" rel="noopener" style="font-family:'Century Gothic',sans-serif;font-weight:700;font-size:0.76rem;color:var(--naranja);">Cómo llegar →</a></div>
      </div>
      <div class="mapa-card">
        <div class="mapa-head"><h4>Planta Pozo Almonte</h4><span class="mono">Ruta 5, cruce Ruta A-687</span></div>
        <div class="mapa-frame"><img src="/img/k-c78146c8.jpg" alt="Mapa de ubicación de Planta Pozo Almonte, Koncreta Prefabricados, Ruta 5 cruce Ruta A-687" style="width:100%;height:100%;object-fit:cover;"></div>
        <div style="padding:16px 24px;border-top:1px solid var(--line-dark);"><a href="https://www.google.com/maps/search/?api=1&query=Ruta+5+cruce+Ruta+A-687+Pozo+Almonte+Chile" target="_blank" rel="noopener" style="font-family:'Century Gothic',sans-serif;font-weight:700;font-size:0.76rem;color:var(--naranja);">Cómo llegar →</a></div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
const reveals = document.querySelectorAll('[data-reveal]');
const io = new IntersectionObserver((entries)=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:0.1});
reveals.forEach(el=>io.observe(el));
</script>
</Base>
