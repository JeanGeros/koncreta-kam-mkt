---
import '../../styles/global.css';
import '../../styles/blog.css';
import Base from '../../layouts/Base.astro';
import { getBlogHome } from '../../lib/blog';
import { BLOG_CATEGORIES } from '../../lib/constants';
import FormattedDate from '../../components/FormattedDate.astro';

const { featured, rest } = await getBlogHome();
const categoryLabel = (value: string) => BLOG_CATEGORIES.find((c) => c.value === value)?.label ?? value;
---

<Base title="Blog — Koncreta Prefabricados">
<!-- ===================== BLOG HERO ===================== -->
<section class="blog-hero" id="inicio">
  <div class="container">
    <div class="idx">Recursos &amp; noticias</div>
    <h1>Blog Koncreta</h1>
    <p>Novedades de la industria del hormigón prefabricado, innovación en planta y participación en el sector.</p>
  </div>
</section>

<!-- ===================== CATEGORY FILTER ===================== -->
<div class="blog-filter-bar">
  <div class="container">
    <div class="blog-filter-track" id="blog-filter-track">
      <span class="blog-chip active" data-cat="todos">Todos</span>
      {BLOG_CATEGORIES.map((c) => <span class="blog-chip" data-cat={c.value}>{c.label}</span>)}
    </div>
  </div>
</div>

<!-- ===================== FEATURED POST ===================== -->
{featured && (
  <section class="blog-featured">
    <div class="container">
      <a class="featured-card" href={`/blog/${featured.slug}`} data-reveal data-cat={featured.category}>
        <div class="featured-media">
          <span class="fm-badge">Destacado</span>
          {featured.hero_image_url && <img src={featured.hero_image_url} alt={featured.hero_image_alt ?? featured.title} />}
        </div>
        <div class="featured-body">
          <span class="fb-tag">{categoryLabel(featured.category)}</span>
          <h2>{featured.title}</h2>
          <p>{featured.excerpt}</p>
          <div class="featured-meta">
            <span>Koncreta Prefabricados</span><span class="fm-dot"></span><span><FormattedDate date={new Date(featured.published_at)} /></span>
          </div>
          <span class="btn btn-outline-dark">Leer artículo completo</span>
        </div>
      </a>
    </div>
  </section>
)}

<!-- ===================== BLOG GRID ===================== -->
<section class="blog-grid-section">
  <div class="container">
    <div class="blog-grid" id="blog-grid" data-reveal>

      {rest.map((post) => (
        <a class="post-card" href={`/blog/${post.slug}`} data-cat={post.category}>
          <div class="post-media">
            <span class="pm-badge">{categoryLabel(post.category)}</span>
            {post.hero_image_url && <img src={post.hero_image_url} alt={post.hero_image_alt ?? post.title} />}
          </div>
          <div class="post-body">
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
            <div class="post-meta"><span class="pm-author">Koncreta Prefabricados</span><span class="pm-dot"></span><span><FormattedDate date={new Date(post.published_at)} /></span></div>
          </div>
        </a>
      ))}

    </div>
    <p id="blog-empty" style={`display:${!featured && rest.length === 0 ? 'block' : 'none'};color:var(--gris-plata);font-size:0.9rem;padding:40px 0;`}>
      {!featured && rest.length === 0 ? 'Aún no hay artículos publicados.' : 'No hay artículos en esta categoría todavía.'}
    </p>
  </div>
</section>

<!-- ===================== NEWSLETTER ===================== -->
<section class="newsletter-strip">
  <div class="container">
    <div class="newsletter-inner" data-reveal>
      <div>
        <h3>Novedades de la industria, directo a tu correo</h3>
        <p>Un correo ocasional con nuevos artículos técnicos y noticias del sector. Sin spam.</p>
      </div>
      <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Formulario de demostración — boceto de diseño.');">
        <input type="email" placeholder="Tu correo" required>
        <button type="submit" class="btn btn-primary">Suscribirme</button>
      </form>
    </div>
  </div>
</section>

<script is:inline>
const reveals = document.querySelectorAll('[data-reveal]');
const io = new IntersectionObserver((entries)=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:0.08});
reveals.forEach(el=>io.observe(el));

// Category filter
const chips = document.querySelectorAll('.blog-chip');
const cards = document.querySelectorAll('.post-card, .featured-card');
const emptyMsg = document.getElementById('blog-empty');
chips.forEach(chip=>{
  chip.addEventListener('click', ()=>{
    chips.forEach(c=>c.classList.remove('active'));
    chip.classList.add('active');
    const cat = chip.dataset.cat;
    let visibleCount = 0;
    cards.forEach(card=>{
      const match = cat === 'todos' || card.dataset.cat === cat;
      card.style.display = match ? '' : 'none';
      if(match) visibleCount++;
    });
    emptyMsg.style.display = visibleCount === 0 ? 'block' : 'none';
  });
});
</script>
</Base>
