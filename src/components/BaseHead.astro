---
import '../styles/global.css';
import { SITE_TITLE, ORGANIZACION } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: string | null;
	type?: 'website' | 'article';
	publishedTime?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, type = 'website', publishedTime } = Astro.props;
const ogImage = new URL(image || '/img/og-default.jpg', Astro.site);

const datosEstructurados = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	'@id': `${ORGANIZACION.url}/#empresa`,
	name: ORGANIZACION.nombre,
	url: ORGANIZACION.url,
	image: new URL('/img/og-default.jpg', Astro.site).href,
	logo: new URL('/logo.png', Astro.site).href,
	description: ORGANIZACION.descripcion,
	telephone: ORGANIZACION.telefono,
	address: {
		'@type': 'PostalAddress',
		streetAddress: ORGANIZACION.direccion.calle,
		addressLocality: ORGANIZACION.direccion.comuna,
		addressRegion: ORGANIZACION.direccion.region,
		postalCode: ORGANIZACION.direccion.codigoPostal,
		addressCountry: 'CL',
	},
	areaServed: ORGANIZACION.plantas.map((p) => ({ '@type': 'City', name: p })),
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
<link rel="apple-touch-icon" href="/favicon-180.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="es_CL" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} is:inline />
