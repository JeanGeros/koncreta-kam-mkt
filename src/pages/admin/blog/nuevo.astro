---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { actions } from 'astro:actions';
import { BLOG_CATEGORIES } from '../../../lib/constants';
import { Icon } from 'astro-icon/components';

const result = Astro.getActionResult(actions.createPost);
if (result && !result.error) {
	return Astro.redirect('/admin/blog');
}
---

<AdminLayout title="Nuevo post">
	<div class="admin-head">
		<div>
			<div class="crumb">Blog</div>
			<h1>Nuevo post</h1>
		</div>
		<div class="form-actions">
			<a href="/admin/blog" class="btn btn-outline-dark">Cancelar</a>
			<button type="submit" form="post-form" class="btn btn-primary">Crear post</button>
		</div>
	</div>
	{result?.error && <p class="action-error">{result.error.message}</p>}
	<form method="POST" action={actions.createPost} enctype="multipart/form-data" class="admin-form" id="post-form">
		<div class="form-grid">
			<div class="form-main">
				<div class="panel">
					<div class="crumb">Información básica<div class="rule"></div></div>
					<div class="field">
						<label for="title">Título</label>
						<input type="text" id="title" name="title" required />
					</div>
					<div class="field">
						<label for="category">Categoría</label>
						<select id="category" name="category" required>
							{BLOG_CATEGORIES.map((c) => <option value={c.value}>{c.label}</option>)}
						</select>
					</div>
					<div class="field">
						<label for="excerpt">Extracto (resumen corto)</label>
						<textarea id="excerpt" name="excerpt" rows="2" required></textarea>
					</div>
				</div>
				<div class="panel">
					<div class="crumb">Contenido<div class="rule"></div></div>
					<div class="field">
						<label for="content">Contenido (Markdown)</label>
						<textarea id="content" name="content" rows="14" required class="mono"></textarea>
						<p class="field-hint">Soporta Markdown: títulos con #, listas con -, negritas con **texto**.</p>
					</div>
				</div>
			</div>
			<div class="form-aside">
				<div class="panel">
					<div class="crumb">Publicación<div class="rule"></div></div>
					<div class="toggle-row">
						<div>
							<div class="label">Destacado</div>
							<div class="hint">Fijar en el listado principal</div>
						</div>
						<label class="toggle-switch">
							<input type="checkbox" id="featured" name="featured" />
							<span class="track"></span>
						</label>
					</div>
					<div class="toggle-row">
						<div>
							<div class="label">Publicado</div>
							<div class="hint">Visible en el sitio público</div>
						</div>
						<label class="toggle-switch">
							<input type="checkbox" id="published" name="published" checked />
							<span class="track"></span>
						</label>
					</div>
				</div>
				<div class="panel">
					<div class="crumb">Imagen<div class="rule"></div></div>
					<div class="field">
						<div class="dropzone">
							<label class="dz-label" for="hero_image">
								<Icon name="material-symbols:cloud-upload" class="icon" /><br />
								Arrastra una imagen o haz clic para elegir<br />
								<small>JPG, PNG o WebP, máx. 5MB</small>
							</label>
							<input type="file" id="hero_image" name="hero_image" accept="image/jpeg,image/png,image/webp" />
						</div>
					</div>
					<div class="field">
						<label for="hero_image_alt">Texto alternativo de la imagen</label>
						<input type="text" id="hero_image_alt" name="hero_image_alt" />
					</div>
				</div>
			</div>
		</div>
		<div class="form-actions">
			<button type="submit" class="btn btn-primary">Crear post</button>
			<a href="/admin/blog" class="btn btn-outline-dark">Cancelar</a>
		</div>
	</form>
</AdminLayout>
