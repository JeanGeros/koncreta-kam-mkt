---
import BlogPost from '../../layouts/BlogPost.astro';
import { getPublishedPostBySlug } from '../../lib/blog';
import { BLOG_CATEGORIES } from '../../lib/constants';

const post = await getPublishedPostBySlug(Astro.params.slug!);
if (!post) {
	return new Response(null, { status: 404 });
}

const categoryLabel = BLOG_CATEGORIES.find((c) => c.value === post.category)?.label ?? post.category;
---

<BlogPost
	title={post.title}
	description={post.excerpt}
	pubDate={new Date(post.published_at)}
	categoryLabel={categoryLabel}
	heroImage={post.hero_image_url}
	heroImageAlt={post.hero_image_alt}
>
	<Fragment set:html={post.content} />
</BlogPost>
